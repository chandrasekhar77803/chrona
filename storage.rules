rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User Document Upload Security Rules
    match /documents/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User Smart Notes Audio File Upload Security Rules
    match /smart_notes/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
  }
}
